FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture i386 \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates \
        git \
        build-essential \
        g++-multilib \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY Makefile /tmp/aoc-native-toolchain/Makefile
COPY scripts/deps/build-deps.lock scripts/deps/fetch-native.py scripts/deps/provenance.py /tmp/aoc-native-toolchain/scripts/deps/
RUN make -C /tmp/aoc-native-toolchain deps-exts-linux DEPS_DIR=/opt/sm-deps \
    && find /opt/sm-deps -name .git -prune -exec sh -c 'git config --system --add safe.directory "$(dirname "$1")"' sh '{}' \; \
    && rm -rf /tmp/aoc-native-toolchain

WORKDIR /workspace
